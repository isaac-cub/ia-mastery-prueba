---
import { sanityClient } from 'sanity:client';
import Landing from '../components/Landing.astro';
// Página pública: contenido publicado, SIN stega (limpia, ligera).
const h = await sanityClient.fetch(`*[_type == "home"][0]`);
// TEMPORAL (solo vista previa): titular nuevo antes de publicarlo en Sanity.
Object.assign(h.hero, {
  h1Line1: 'Crea contenido profesional con IA',
  h1Highlight: 'por una fracción',
  h1Line3: 'del coste. Sin suscripciones obligatorias.',
});
h.seoTitle = 'AI Mastery — Crea contenido profesional con IA por una fracción del coste';
---
<Landing h={h} />
