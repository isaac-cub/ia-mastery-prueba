---
const { d, ratio, embedUrl, thumb, src, poster, class: cls = '' } = Astro.props;
---
<article class={`reveal ${cls} grid ${d.videoEmbed ? (ratio < 1 ? 'md:grid-cols-[1fr_auto]' : 'md:grid-cols-[1fr_1.35fr]') : 'md:grid-cols-[1.2fr_1fr]'} gap-0 bg-ink text-white rounded-3xl overflow-hidden card-glow`}>
  <div class="p-8 md:p-10 flex flex-col justify-center">
    <span class="inline-flex w-max items-center gap-1.5 bg-gold text-ink text-[11px] font-bold px-2.5 py-1 rounded-full mb-4">{d.badge}</span>
    <h3 class="font-display font-extrabold text-2xl md:text-3xl leading-tight">{d.title}</h3>
    <p class="mt-3 text-white/70 leading-relaxed max-w-md">{d.text}</p>
  </div>
  {d.videoEmbed
    ? <div class={`relative bg-black ${ratio < 1 ? 'md:w-[380px]' : 'md:self-center'}`} style={`aspect-ratio:${ratio}`}>
        <button type="button" class="vsl absolute inset-0 w-full h-full group/vsl" data-embed={embedUrl} aria-label="Reproducir el vídeo">
          {thumb && <img src={thumb} alt="" class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async" onerror="this.remove()" />}
          <span class="absolute inset-0 grid place-items-center">
            <span class="w-16 h-16 rounded-full bg-gold grid place-items-center shadow-lg transition-transform duration-300 group-hover/vsl:scale-110">
              <span class="ml-1 border-y-[11px] border-y-transparent border-l-[18px] border-l-ink"></span>
            </span>
          </span>
        </button>
      </div>
    : <div class="relative min-h-[220px] bg-black">
        <video class="vid" src={src} data-poster={poster} muted loop playsinline preload="none"></video>
      </div>}
</article>
